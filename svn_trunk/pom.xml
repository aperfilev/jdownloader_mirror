<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jdownloader</groupId>
    <artifactId>jdownloader-mirror</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>svn-trunk</artifactId>
  <packaging>jar</packaging>
  <name>JDownloader2</name>
  <description>JDownloader2 desktop application</description>
  <properties>
    <main.class>org.jdownloader.launcher.JDLauncher</main.class>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.jdownloader</groupId>
      <artifactId>svn-utils</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jdownloader</groupId>
      <artifactId>svn-browser</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.jdownloader</groupId>
      <artifactId>svn-my-jdownloader-client</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk15on</artifactId>
      <version>1.78</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/ressourcen/libs/bcprov-jdk15on.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk15on</artifactId>
      <version>1.78</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/ressourcen/libs/bcpkix-jdk15on.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bctls-jdk15on</artifactId>
      <version>1.78</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/ressourcen/libs/bctls-jdk15on.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcutil-jdk15on</artifactId>
      <version>1.78</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/ressourcen/libs/bcutil-jdk15on.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>net.sf.sevenzipjbinding</groupId>
      <artifactId>sevenzipjbinding</artifactId>
      <version>9.20.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/ressourcen/libs/sevenzipjbinding.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.seamless</groupId>
      <artifactId>seamless-util</artifactId>
      <version>1.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/ressourcen/libs/UPNP/seamless-util.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.mozilla</groupId>
      <artifactId>rhino</artifactId>
      <version>1.7.14</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/ressourcen/libs/js.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.tmatesoft.svnkit</groupId>
      <artifactId>svnkit</artifactId>
      <version>1.10.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/ressourcen/libs/svnkit.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.btr.proxy</groupId>
      <artifactId>proxy</artifactId>
      <version>1.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/ressourcen/libs/proxyVole.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.fourthline.cling</groupId>
      <artifactId>cling-core</artifactId>
      <version>2.0.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/ressourcen/libs/UPNP/cling-core.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.fourthline.cling</groupId>
      <artifactId>cling-support</artifactId>
      <version>2.0.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/ressourcen/libs/UPNP/cling-support.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>net.sf.image4j</groupId>
      <artifactId>image4j</artifactId>
      <version>1.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/ressourcen/libs/image4j.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>net.lingala.zip4j</groupId>
      <artifactId>zip4j</artifactId>
      <version>1.3.2</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/ressourcen/libs/zip4j.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>de.javasoft</groupId>
      <artifactId>synthetica</artifactId>
      <version>2.23</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/ressourcen/libs/laf/synthetica.jar</systemPath>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <id>add-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>src</source>
                <source>src-closed</source>
                <source>translations</source>
                <source>themes</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
          <encoding>UTF-8</encoding>
          <failOnError>false</failOnError>
          <excludes>
            <exclude>**/extensions/**</exclude>
            <exclude>**/plugins/components/antiDDoS*.java</exclude>
            <exclude>**/scripting/**</exclude>
            <exclude>**/captcha/**</exclude>
            <exclude>**/*BCSSLSocketStreamFactory*</exclude>
            <exclude>**/*SimpleFTP*</exclude>
            <exclude>**/Plugin.java</exclude>
            <exclude>**/SecondLevelLaunch.java</exclude>
            <exclude>**/nutils/**</exclude>
            <exclude>**/plugins/components/XFileSharingProBasic.java</exclude>
            <exclude>**/controlling/reconnect/pluginsinc/upnp/cling/StreamClientImpl.java</exclude>
            <exclude>**/plugins/download/DownloadLinkDownloadable.java</exclude>
            <exclude>**/jd/plugins/hoster/**</exclude>
            <exclude>**/jd/plugins/decrypter/**</exclude>
            <exclude>**/jd/plugins/download/**</exclude>
            <exclude>**/crosssystem/macos/**</exclude>
            <exclude>**/gui/laf/**</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${main.class}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
