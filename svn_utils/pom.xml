<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.jdownloader</groupId>
    <artifactId>jdownloader-mirror</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>svn-utils</artifactId>
  <packaging>jar</packaging>
  <dependencies>
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>5.13.0</version>
    </dependency>
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna-platform</artifactId>
      <version>5.13.0</version>
    </dependency>
    <dependency>
      <groupId>com.miglayout</groupId>
      <artifactId>miglayout-swing</artifactId>
      <version>5.3</version>
    </dependency>
    <dependency>
      <groupId>com.miglayout</groupId>
      <artifactId>miglayout-core</artifactId>
      <version>5.3</version>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>9.7</version>
    </dependency>
    <dependency>
      <groupId>com.github.weisj</groupId>
      <artifactId>jsvg</artifactId>
      <version>1.0.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/libs/jsvg.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>com.kitfox.svg</groupId>
      <artifactId>svg-salamander</artifactId>
      <version>1.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/libs/svgSalamander.jar</systemPath>
    </dependency>
  </dependencies>
  <build>
    <sourceDirectory>src</sourceDirectory>
    <resources>
      <resource>
        <directory>src</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
          <encoding>UTF-8</encoding>
          <excludes>
            <exclude>**/test/**</exclude>
            <exclude>**/moncompare/test/**</exclude>
            <exclude>**/utils/images/svg/WeisjJSVG*.java</exclude>
            <exclude>**/utils/net/httpclient/Response.java</exclude>
            <exclude>**/utils/net/httpconnection/CompositeTrustResult.java</exclude>
            <exclude>**/utils/net/httpconnection/NativeSSLSocketStreamFactory.java</exclude>
            <exclude>**/utils/net/httpconnection/trust/TrustAllProvider.java</exclude>
            <exclude>**/utils/images/ProxyIcon.java</exclude>
            <exclude>**/utils/zip/ZipUtils.java</exclude>
            <exclude>**/jna/tests/TestJNAWIndowqsProcessHandler.java</exclude>
            <exclude>**/jna/processes/JNAWindowsProcessHandler.java</exclude>
            <exclude>**/processes/jna/JNAWindowsProcessHandler.java</exclude>
            <exclude>**/utils/net/httpserver/HttpConnection.java</exclude>
            <exclude>**/utils/net/httpserver/SSLConnectionWrapper.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
